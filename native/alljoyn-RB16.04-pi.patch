+        //
+        // Scan every message in the datagram just read for NLMSG_DONE, not only
+        // the first one.  Modern kernels coalesce the terminating NLMSG_DONE into
+        // the same datagram as the last data message; checking only the first
+        // header misses it and the following recv() then blocks forever.  Both
+        // callers already ignore NLMSG_DONE/NLMSG_ERROR entries, so it is safe
+        // to include this datagram in the returned length.
+        //
+        bool done = false;
+        int len = tmp;
+        for (struct nlmsghdr* p = (struct nlmsghdr*)&buffer[nBytes]; NLMSG_OK(p, len); p = NLMSG_NEXT(p, len)) {
+            if (p->nlmsg_type == NLMSG_DONE || p->nlmsg_type == NLMSG_ERROR) {
+                done = true;
+                break;
+            }
         }
 
         nBytes += tmp;
+
+        if (done) {
+            break;
+        }
     }
 
     return nBytes;
