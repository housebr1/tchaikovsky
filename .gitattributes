* text=auto

# Must stay LF: consumed by Linux tooling (shell, docker build, patch) where
# CRLF breaks shebangs, line continuations, or patch application against
# LF-only upstream sources.
gradlew text eol=lf
*.sh text eol=lf
*.patch text eol=lf
native/Dockerfile text eol=lf
gradlew.bat text eol=crlf
*.jar binary
*.so binary
native/prebuilt/alljoyn-daemon binary
examples/pcm-pace text eol=lf
