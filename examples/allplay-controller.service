[Unit]
Description=AllPlay zone controller (groups speakers onto the Icecast stream)
Documentation=https://github.com/housebr1/tchaikovsky
# Ordering only. The controller tolerates the mount 404ing and waits for it, so
# Icecast being slow to start is not a failure.
After=network-online.target icecast2.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/allplay

# liballjoyn_java.so must be on java.library.path.
#
# org.alljoyn.bus.address=null: uses the router bundled into the .so. Remove it
# if you run a standalone alljoyn-daemon, which discovers faster.
#
# stream.url may name loopback; the controller rewrites it to this host's LAN
# address, because the speakers fetch the stream from their own machines.
#
# The volume band maps the 0-100 slider onto 8-35 of each speaker's range. The
# ceiling is there because the top of the range is far louder than these rooms
# need; the floor because the bottom of the slider otherwise goes inaudible
# before it reaches zero. Both tuned by ear; adjust live with /band.
#
# These three are only first-run defaults. Live changes are persisted to
# allplay.state in the working directory and restored on startup, so whatever
# you set by ear survives reboots and these values are not consulted again.
#
# The Spotify app's slider drives the same endpoint via librespot-event.sh.
ExecStart=/home/pi/jre17/bin/java \
    -Xmx96m \
    -Djava.library.path=/home/pi/allplay \
    -Dorg.alljoyn.bus.address=null: \
    -Dstream.url=http://127.0.0.1:8000/spotify.mp3 \
    -Dvolume=75 \
    -Dvolume.floor=8 \
    -Dvolume.ceiling=35 \
    -Dcontrol.port=8080 \
    -Ddiscovery.seconds=25 \
    -Dpoll.seconds=12 \
    -cp /home/pi/allplay/tchaikovsky.jar:/home/pi/allplay \
    AllPlayController

Restart=always
RestartSec=15
# A JVM stopped by SIGTERM exits 143 (128+15). Without this systemd records a
# clean stop as "Failed with result 'exit-code'".
SuccessExitStatus=143
# Give the shutdown hook time to stop playback, dissolve the zone and drop the
# speakers cleanly; killing it early leaves the speakers grouped and playing.
TimeoutStopSec=45
KillSignal=SIGTERM

# The Pi Zero 2 W has ~424 MB usable. Cap the service so a leak cannot take the
# audio pipeline down with it.
MemoryMax=220M

StandardOutput=journal
SyslogIdentifier=allplay
# AllJoyn's native layer writes thousands of errors to stderr from its router
# threads while the bus is torn down. The controller logs everything it cares
# about on stdout, including an uncaught-exception handler, so dropping stderr
# removes the flood without losing anything the controller reports.
#
# Rate limiting was tried first and was worse: the native burst consumed the
# allowance before the controller's own startup output, so journald reported
# "Suppressed 6830 messages" and the useful lines were the ones lost.
StandardError=null

[Install]
WantedBy=multi-user.target
