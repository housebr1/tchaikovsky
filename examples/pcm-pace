#!/usr/bin/env python3
"""Pace s16le 44100 stereo PCM to realtime without catching up after a stall.

ffmpeg -re uses wall-clock from process start: after a Spotify pause of N
seconds it burst-reads N seconds of audio so librespot's playhead jumps N
seconds ahead, revealed the next time the app pauses. A token bucket with a
small burst does not accumulate credit while the FIFO is idle.

When the FIFO is idle (Spotify paused), write silence at the same rate so
ffmpeg keeps the Icecast connection alive. Otherwise the next real PCM hits a
dead socket, ffmpeg dies (broken pipe), and the first track is silent until
the encoder restarts.
"""
from __future__ import print_function

import os
import select
import sys
import time

RATE = 44100 * 2 * 2  # bytes/s: 44100 Hz, 2 ch, s16le
BURST = RATE * 0.1  # 100 ms of credit, not the pause duration
CHUNK = 4096
SILENCE = b"\x00" * CHUNK


def main():
    infd = sys.stdin.fileno()
    stdout = sys.stdout.buffer
    tokens = BURST
    last = time.monotonic()
    while True:
        ready, _, _ = select.select([infd], [], [], 0.02)
        if ready:
            data = os.read(infd, CHUNK)
            if not data:
                data = SILENCE
        else:
            data = SILENCE
        now = time.monotonic()
        tokens = min(BURST, tokens + (now - last) * RATE)
        last = now
        need = len(data)
        if tokens < need:
            time.sleep((need - tokens) / RATE)
            now = time.monotonic()
            tokens = min(BURST, tokens + (now - last) * RATE)
            last = now
        tokens -= need
        stdout.write(data)
        stdout.flush()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
